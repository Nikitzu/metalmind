#!/usr/bin/env bash
# metalmind output-style activation hook — SessionStart event.
#
# Why this exists: Claude Code loads `~/.claude/output-styles/<name>.md` into
# the system prompt once at session start. After context compaction, long
# turns, or task pressure, the style section loses weight relative to recent
# context and the model drifts back to verbose prose. This hook re-emits the
# active style's full body as `additionalContext` every session start, so the
# rules are anchored at the *top* of the visible context window — not the
# bottom of a buried system section.
#
# Reads `outputStyle` from ~/.claude/settings.json (or $CLAUDE_CONFIG_DIR),
# loads the matching style file, strips its frontmatter, and emits the body
# as JSON additionalContext. No-ops silently when no style is active or the
# file is missing — never breaks a session.

set -euo pipefail

CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS="$CONFIG_DIR/settings.json"
STYLES_DIR="$CONFIG_DIR/output-styles"

[ -f "$SETTINGS" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

ACTIVE=$(jq -r '.outputStyle // empty' "$SETTINGS" 2>/dev/null || true)
[ -n "$ACTIVE" ] || exit 0

STYLE_FILE="$STYLES_DIR/$ACTIVE.md"
[ -f "$STYLE_FILE" ] || exit 0

# Strip leading YAML frontmatter (between two `---` lines on column 1) if
# present. Body starts after the closing fence.
BODY=$(awk '
  BEGIN { state = "scan" }
  state == "scan" && /^---$/ { state = "fm_open"; next }
  state == "scan" { state = "body"; print; next }
  state == "fm_open" && /^---$/ { state = "body"; next }
  state == "fm_open" { next }
  state == "body" { print }
' "$STYLE_FILE")

[ -n "$BODY" ] || exit 0

# Emit as SessionStart additionalContext. The leading reminder text tells the
# model this is a re-anchor of an already-loaded style — not a new instruction.
PREAMBLE="Output style '$ACTIVE' is active. The rules below are re-anchored at session start to survive compaction and prevent drift. Follow them from the first token of every response, including acknowledgements and confirmations. No warm-up phrases. No drift under task load."

jq -nc --arg ctx "$PREAMBLE"$'\n\n'"$BODY" '{
  hookSpecificOutput: {
    hookEventName: "SessionStart",
    additionalContext: $ctx
  }
}'
