                <tr class="bench-row-highlight"><th scope="row">metalmind</th><td>~519</td></tr>
                <tr><th scope="row">native <code>/memory</code></th><td>~1</td></tr>
                <tr><th scope="row">metalmind <small>(stdio MCP)</small></th><td>~157</td></tr>
