            <div class="proof-card-eyebrow">Recall quality · 12 gold + N distractors</div>
            <table class="proof-card-table">
              <thead>
                <tr><th scope="col">vault</th><th scope="col">hit@1<br /><small>+rerank</small></th><th scope="col">hit@5<br /><small>+rerank</small></th></tr>
              </thead>
              <tbody>
                <tr><th scope="row">12 notes</th><td>90%</td><td>95%</td></tr>
                <tr><th scope="row">100 notes</th><td>90%</td><td>95%</td></tr>
