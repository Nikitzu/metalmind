---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSystem from '../components/HeroSystem.astro';
import ModulesGrid from '../components/ModulesGrid.astro';
import Proof from '../components/Proof.astro';
import Demo from '../components/Demo.astro';
import Compare from '../components/Compare.astro';
import Install from '../components/Install.astro';
import Commands from '../components/Commands.astro';
import CookbookHighlights from '../components/CookbookHighlights.astro';

const title = 'metalmind - the missing standard library for Claude Code, Codex, and Cursor';
const description = 'Memory, vault sync, code intelligence, daily workflow, deliberation. Claude Code, Codex CLI, and Cursor. Local. Integrated. Zero standing MCP-schema tax.';
---
<BaseLayout title={title} description={description}>
  <HeroSystem />
  <ModulesGrid />
  <Proof />
  <Demo />
  <Compare />
  <Install />
  <Commands />
  <CookbookHighlights />
</BaseLayout>
