---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import TermSwap from '../components/TermSwap.astro';

const title = 'Health - doctor · metalmind';
const description = 'A clean diagnostic - or a precise reason it isn\'t clean. Every subsystem probed, one verdict.';

const checks = [
  { label: 'watcher - service loaded + active',        state: 'ok',   note: '' },
  { label: 'recall-http - 127.0.0.1:17317 reachable',  state: 'ok',   note: '' },
  { label: 'global-claude-md - stamp present',         state: 'ok',   note: '' },
  { label: 'vault-claude-md - stamp present',          state: 'ok',   note: '' },
  { label: 'codex-agents-md - sentinel block',         state: 'ok',   note: '' },
  { label: 'cursor-recall-skill - installed',          state: 'ok',   note: '' },
  { label: 'supersede-integrity - pointers resolve',   state: 'warn', note: "old-plan: superseded_by 'gone' does not resolve" },
  { label: 'code-refs-integrity - refs resolve',       state: 'fail', note: 'auth-decision: coreapi#LegacyGuard missing' },
];
const mark = (s: string) => (s === 'ok' ? '✓' : s === 'warn' ? '⚠' : '✗');
---
<BaseLayout title={title} description={description}>
  <PageHero
    metal="iron"
    eyebrow="doctor · audit"
    eyebrowScadrial="pulse"
    title="A clean diagnostic, or a precise reason it isn't clean."
    sub="Iron is metalmind's self-check. Eight subsystem probes, each printing pass or the exact path to the broken file. One command tells you whether the rest of the library can do its job."
  />

  <section>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">§ <TermSwap classic="metalmind doctor" scadrial="metalmind pulse" mono /></div>
        <h2>Every subsystem, one verdict.</h2>
        <p><span class="kbd">--deep</span> adds live probes: watcher state, the loopback endpoint, per-host stamps, and the supersede and code-ref integrity checks over your own vault.</p>
      </div>

      <div class="doctor-card">
        <div class="doctor-head mono">
          <span class="prompt">$</span> <span class="cmd">metalmind <TermSwap classic="doctor" scadrial="pulse" /></span>
          <span class="doctor-time mono">· 1.2s · 6 / 8 ok</span>
        </div>
        <div class="doctor-body">
          {checks.map((c) => (
            <div class={`doctor-row doctor-${c.state}`}>
              <div class="doctor-mark mono">{mark(c.state)}</div>
              <div class="doctor-label">{c.label}</div>
              {c.note && <div class="doctor-note mono">{c.note}</div>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="feat-grid">
        <div class="feat-card">
          <div class="feat-num mono accent-text">01</div>
          <h3 class="display feat-h">No mystery failures</h3>
          <p>Every red row prints the file path, the exact failed assertion, and the doc page that explains the fix. No "something went wrong."</p>
        </div>
        <div class="feat-card">
          <div class="feat-num mono accent-text">02</div>
          <h3 class="display feat-h">Recall audit</h3>
          <p>
            <TermSwap classic="doctor" scadrial="pulse" mono />
            <span class="kbd">--recall-audit</span> replays your opt-in recall log and classifies past queries as ok, weak-hit, or zero-hit - the queries that came back empty are your best <span class="kbd">/save</span> candidates.
          </p>
        </div>
        <div class="feat-card">
          <div class="feat-num mono accent-text">03</div>
          <h3 class="display feat-h">CI-friendly</h3>
          <p>Exit code 0 only on full green. Wire <span class="kbd"><TermSwap classic="doctor" scadrial="pulse" /> --deep</span> into a pre-commit hook or your team's CI to fail fast on a broken vault.</p>
        </div>
      </div>
    </div>
  </section>

  <PageCTA heading="When something feels off, run iron first." />
</BaseLayout>
