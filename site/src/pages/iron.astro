---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import TermSwap from '../components/TermSwap.astro';

const title = 'Health - doctor · metalmind';
const description = 'A clean diagnostic - or a precise reason it isn\'t clean. Eight subsystem probes, one verdict.';

const checks = [
  { label: 'Vault is reachable + writable',     state: 'ok',   note: '' },
  { label: 'Watcher loopback HTTP responding',   state: 'ok',   note: '' },
  { label: 'MCP fallback channel registered',    state: 'ok',   note: '' },
  { label: '~/.claude/CLAUDE.md stamp present',  state: 'ok',   note: '' },
  { label: 'Embedding index up to date',         state: 'warn', note: '12 notes pending re-embed' },
  { label: 'Serena LSP backend reachable',       state: 'ok',   note: '' },
  { label: 'OpenAPI shelf parses cleanly',       state: 'fail', note: 'notif-svc-v3.yaml - invalid $ref' },
  { label: 'EOD launchd agent loaded',           state: 'ok',   note: '' },
];
const mark = (s: string) => (s === 'ok' ? '✓' : s === 'warn' ? '⚠' : '✗');
---
<BaseLayout title={title} description={description}>
  <PageHero
    metal="iron"
    eyebrow="doctor · audit"
    eyebrowScadrial="burn iron · pulse"
    title="A clean diagnostic, or a precise reason it isn't clean."
    sub="Iron is metalmind's self-check. Eight subsystem probes, each printing pass or the exact path to the broken file. One command tells you whether the rest of the library can do its job."
  />

  <section>
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">§ <TermSwap classic="metalmind doctor" scadrial="metalmind pulse" mono /></div>
        <h2>Eight probes, one verdict.</h2>
        <p><span class="kbd">--recall-audit</span> extends the run with a benchmark over your own vault - same harness as the published recall numbers, against your own notes.</p>
      </div>

      <div class="doctor-card">
        <div class="doctor-head mono">
          <span class="prompt">$</span> <span class="cmd">metalmind <TermSwap classic="doctor" scadrial="pulse" /></span>
          <span class="doctor-time mono">· 1.2s · 6 / 8 ok</span>
        </div>
        <div class="doctor-body">
          {checks.map((c) => (
            <div class={`doctor-row doctor-${c.state}`}>
              <div class="doctor-mark mono">{mark(c.state)}</div>
              <div class="doctor-label">{c.label}</div>
              {c.note && <div class="doctor-note mono">{c.note}</div>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="feat-grid">
        <div class="feat-card">
          <div class="feat-num mono accent-text">01</div>
          <h3 class="display feat-h">No mystery failures</h3>
          <p>Every red row prints the file path, the exact failed assertion, and the doc page that explains the fix. No "something went wrong."</p>
        </div>
        <div class="feat-card">
          <div class="feat-num mono accent-text">02</div>
          <h3 class="display feat-h">Recall audit</h3>
          <p>
            <TermSwap classic="doctor" scadrial="pulse" mono />
            <span class="kbd">--recall-audit</span> spawns the recall harness against your vault - hit@1, hit@5, latency p50/p95 - so you can see whether your data is still indexed clean.
          </p>
        </div>
        <div class="feat-card">
          <div class="feat-num mono accent-text">03</div>
          <h3 class="display feat-h">CI-friendly</h3>
          <p>Exit code 0 only on full green. Wire <span class="kbd"><TermSwap classic="doctor" scadrial="pulse" /> --json</span> into a pre-commit hook or your team's CI to fail fast on a broken vault.</p>
        </div>
      </div>
    </div>
  </section>

  <PageCTA heading="When something feels off, run iron first." />
</BaseLayout>
