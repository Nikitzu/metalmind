---
import BaseLayout from '../layouts/BaseLayout.astro';
import cliPkg from '../../../cli/package.json';
const version = cliPkg.version;

const title = 'Releases · metalmind';
const description = 'Release notes and changelog for metalmind — one entry per tag.';

// Highlights of the most recent releases. Full CHANGELOG lives on GitHub.
const releases = [
  {
    tag: '0.8.3',
    date: '2026-05-07',
    headline: 'Bundled output styles silently inactive on fresh install',
    summary: 'Claude Code matches settings.outputStyle against the name: frontmatter case-sensitively. The CLI wrote settings.outputStyle = "marsh" (lowercase) but the bundled cli/assets/marsh.md shipped with name: Marsh (capitalized) — so on every fresh install the file landed, the setting pointed at it, the file looked correct, and the style never applied. Same for terse. Caught only because the user had a pre-existing hand-authored lowercase copy. Fixed by lowercasing the asset name field and the legacy-migration write path. Bonus: dropped keep-coding-instructions: true from both shipped frontmatters — not a recognized output-style field.',
    tag_kind: 'fixed',
  },
  {
    tag: '0.8.2',
    date: '2026-05-06',
    headline: 'metalmind gold rewrites wikilinks across the vault on archive',
    summary: 'Same shape as scribe rename: when you archive a note, [[wikilinks]] in every other note that references it get rewritten to the new Archive/ path. Closes the v0.8.1 gotcha where archiving the two Codex plans left dangling links scattered across the MOC. Basename-only wikilinks survive unchanged. Plus: README anti-personas section dropped (was the same fabricated content we removed from the site in v0.7.x); releases page caught up to v0.8.x.',
    tag_kind: 'fixed',
  },
  {
    tag: '0.8.1',
    date: '2026-05-06',
    headline: 'Three v0.8.0 follow-ups cleared',
    summary: '(1) doctor codex-mcp check no longer misattributes 5s timeouts as "binary not on PATH" — disambiguated via a `which codex` probe first. (2) synod + writing-vault-notes skill bundles extracted to cli/templates/.shared/skills/ — drift impossible by construction. (3) New doctor codex-agents-mirror check warns when ~/.agents/skills/ holds stale broken copies. No template-content changes, no re-stamp required for v0.8.0 users.',
    tag_kind: 'fixed',
  },
  {
    tag: '0.8.0',
    date: '2026-05-06',
    headline: 'Codex CLI as a first-class metalmind host',
    summary: 'metalmind init --host codex (or via the new multi-select prompt) stamps Codex with the same recall-first behaviour Claude Code gets. Seven artifacts: AGENTS.md sentinel block, SessionStart hook (reuses CC hook script verbatim — Codex JSON shape is identical), [sandbox_workspace_write] network_access=true, ~/.codex/rules/metalmind.rules pre-approving the metalmind command surface, three skills (writing-vault-notes, synod, save), opt-in --with-mcp. /save body extracted to .shared partial; CC slash-command + Codex skill source from one body — drift impossible by construction.',
    tag_kind: 'added',
  },
  {
    tag: '0.7.0',
    date: '2026-05-05',
    headline: 'Repositioned as the Claude Code standard library',
    summary: 'Six modules — memory, code intelligence, daily workflow, deliberation, desktop integration, health — share state through one vault, one CLI, one stamped CLAUDE.md rule. Memory stays the headline; the rest is the moat. New site, new comparison-matrix rows, new Architecture + Cookbook docs.',
    tag_kind: 'changed',
  },
  {
    tag: '0.6.2',
    date: '2026-05-05',
    headline: 'Vault CLAUDE.md aligned with global block',
    summary: 'Closed four contradictions between the vault stamped block and the global one (folder list, write contract, raw-Write rule, MOC location).',
    tag_kind: 'fixed',
  },
  {
    tag: '0.6.1',
    date: '2026-05-05',
    headline: 'Stamped rules no longer contradict the CLI contract',
    summary: 'Scribe daily-date guard (Fixed + Breaking) — every mutating scribe verb refuses non-today daily writes without --date. Plus eight stamped-rule contradictions closed across CLAUDE.md.block.template, save.md, and writing-vault-notes/SKILL.md.',
    tag_kind: 'fixed',
  },
  {
    tag: '0.6.0',
    date: '2026-05-03',
    headline: 'Synod skill + metalmind synod command',
    summary: 'A 7-persona deliberative council debate. Each persona spawns as a parallel subagent, the main agent synthesises a structured verdict (position, confidence %, 3 risks, 5 next steps, minority report).',
    tag_kind: 'added',
  },
  {
    tag: '0.5.7',
    date: '2026-05-02',
    headline: 'graphify no longer pollutes ~/CLAUDE.md',
    summary: 'graphify claude install was running with cwd=$HOME, dropping a graphify stamp at ~/CLAUDE.md that injected unrelated instructions into every session under $HOME. Now spawns from a temp directory; legacy stale stamps are stripped on every init.',
    tag_kind: 'fixed',
  },
];
---
<BaseLayout title={title} description={description}>
  <section class="page-hero" style="--mod-color: var(--metal-copper)">
    <div class="container">
      <div class="page-hero-eyebrow">
        <span class="mod-dot"></span>
        <span class="mono">releases</span>
        <span class="page-hero-sep">·</span>
        <span class="mono">v{version}</span>
      </div>
      <h1 class="display page-hero-title">Release notes.</h1>
      <p class="page-hero-sub">
        One entry per tag. Recent highlights below — the full CHANGELOG with every entry, breaking-change migration notes, and bench numbers lives in the repo.
      </p>
      <p style="margin-top: var(--space-4)">
        <a class="btn btn-ghost" href="https://github.com/Nikitzu/metalmind/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Full CHANGELOG on GitHub →</a>
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="release-list">
        {releases.map((r) => (
          <article class="release-entry">
            <header class="release-head">
              <a class="release-tag mono" href={`https://github.com/Nikitzu/metalmind/releases/tag/v${r.tag}`} target="_blank" rel="noopener">v{r.tag}</a>
              <span class="release-date mono">{r.date}</span>
              <span class={`release-kind release-kind-${r.tag_kind} mono`}>{r.tag_kind}</span>
            </header>
            <h2 class="display release-h">{r.headline}</h2>
            <p class="release-sum">{r.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .release-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 760px;
    margin: 0 auto;
  }
  .release-entry {
    padding: var(--space-5) var(--space-5) var(--space-6);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    border-left: 3px solid var(--accent);
  }
  .release-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .release-tag {
    font-size: 13px;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    background: color-mix(in oklch, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--accent) 30%, transparent);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }
  .release-tag:hover { filter: brightness(1.1); }
  .release-date { font-size: 12px; color: var(--ink-faint); letter-spacing: 0.05em; }
  .release-kind {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    color: var(--ink-faint);
  }
  .release-kind-added { color: var(--metal-copper); border-color: color-mix(in oklch, var(--metal-copper) 35%, transparent); }
  .release-kind-fixed { color: var(--metal-brass); border-color: color-mix(in oklch, var(--metal-brass) 35%, transparent); }
  .release-kind-changed { color: var(--metal-steel); border-color: color-mix(in oklch, var(--metal-steel) 35%, transparent); }
  .release-h {
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 400;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .release-sum {
    margin: 0;
    color: var(--ink-mute);
    font-size: 15px;
    line-height: 1.6;
  }
</style>
