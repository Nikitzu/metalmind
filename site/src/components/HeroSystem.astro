---
import SystemDiagram from './SystemDiagram.astro';
import cliPkg from '../../../cli/package.json';
const version = cliPkg.version;
---
<section class="hero hero-system" id="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="dot"></span>&nbsp;&nbsp;v{version} — released today</div>
        <h1 class="display hero-title">
          The missing <span class="accent-text">standard&nbsp;library</span><br/>
          for Claude Code.
        </h1>
        <p class="hero-sub">
          Six modules. One vault. Memory that compounds across repos, code intelligence that crosses service boundaries, daily routines that carry themselves forward — all sharing state, none paying the MCP-schema tax.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#install">
            <span class="mono">$</span>&nbsp;npm i -g metalmind
          </a>
          <a class="btn btn-ghost" href="#modules">See the six modules →</a>
        </div>
        <div class="hero-meta">
          <span><span class="mono accent-text">0</span> standing tool schemas</span>
          <span class="hero-meta-dot">·</span>
          <span><span class="mono accent-text">100%</span> local</span>
          <span class="hero-meta-dot">·</span>
          <span><span class="mono accent-text">1</span> command to uninstall</span>
        </div>
      </div>
      <div class="hero-visual">
        <SystemDiagram />
      </div>
    </div>
  </div>
</section>
