---
interface Props {
  size?: number;
  className?: string;
}
const { size = 26, className = '' } = Astro.props;
---
<svg viewBox="0 0 32 32" width={size} height={size} fill="none" aria-hidden="true" class={className}>
  <defs>
    <linearGradient id="lg-mm" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--accent)" />
      <stop offset="1" stop-color="var(--accent)" stop-opacity="0.5" />
    </linearGradient>
  </defs>
  <circle cx="16" cy="16" r="13" stroke="var(--accent)" stroke-width="1.2" />
  <circle cx="16" cy="16" r="3.2" fill="url(#lg-mm)" />
  {[0,45,90,135,180,225,270,315].map((deg, i) => {
    const r = 9.5;
    const x = 16 + r * Math.cos((deg-90) * Math.PI/180);
    const y = 16 + r * Math.sin((deg-90) * Math.PI/180);
    return <circle cx={x} cy={y} r="1.4" fill="var(--accent)" opacity={0.4 + i*0.07} />;
  })}
</svg>
