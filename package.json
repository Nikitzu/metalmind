{
  "name": "metalmind-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "metalmind - unified CLI for vault, code graph, and cross-repo intelligence.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --parallel build",
    "dev": "pnpm --filter metalmind dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "bench:recall": "node bench/recall-v0/run.mjs",
    "bench:recall-at-scale": "node bench/recall-at-scale/run.mjs",
    "bench:recall-at-scale:fetch": "node bench/recall-at-scale/scripts/fetch-hn.mjs",
    "bench:recall-at-scale:seed": "node bench/recall-at-scale/scripts/seed-gold.mjs",
    "bench:mcp-tax": "node bench/mcp-tax-v0/run.mjs",
    "test:skills": "node cli/scripts/resolve-skill-evals.mjs | xargs npx agent-skills-eval --baseline --strict"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12"
  }
}
