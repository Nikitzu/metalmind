# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Local testing
*.bak
*.bak-*
test-vault/
__pycache__/
*.pyc
.venv/

# Never commit a filled-in config
**/serena_config.local.yml

# Node / pnpm / TS
node_modules/
dist/
coverage/
*.tsbuildinfo
.pnpm-store/

# Generated copy of packages/vault-rag (source of truth lives at packages/vault-rag/).
# Populated by cli/scripts/sync-vault-rag-pkg.mjs at build/prepack time so the
# npm tarball can bundle the Python package next to dist/cli.js.
cli/templates/vault-rag-pkg/

# Astro
.astro/

# recall-v0 bench - the distractor corpus is committed. It was ignored on the
# theory that the generator regenerates it deterministically, which held until
# the repo-wide em-dash sweep edited the generator and silently changed every
# note it produces. Published numbers outlived the corpus they described.
bench/recall-v0/results/*
!bench/recall-v0/results/.gitkeep

# compact-v0 bench: run.mjs is source of truth; results regenerate.
bench/compact-v0/results/*
!bench/compact-v0/results/.gitkeep

# Working spec for in-flight branch (lives in metalmind vault, not git)
SPEC.md
tasks/

# specs/ is excluded by the global gitignore; design history belongs in this repo.
!specs/
